# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# bun.lock is the canonical lockfile; don't let a stray npm install re-add this
package-lock.json

# testing
/coverage
/playwright-report
/test-results
.playwright-mcp/
.playwright-cli/
.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# local voice cloning
/voice/
scripts/.tts-venv/
__pycache__/
public/audio/.tmp/
/tmp/

# Blog audio is served from Vercel Blob (NEXT_PUBLIC_AUDIO_CDN_URL), not the
# repo — migrated 2026-08-17, see docs/operations.md "Serving Audio From A
# CDN". New MP3s belong in the Blob store (upload + verify-audio-cdn), never
# in git. Old MP3 blobs remain in git history until a history purge.
public/audio/*.mp3

# Agent worktrees. Claude Code's EnterWorktree creates full checkouts here;
# without this they show up as untracked and a whole repo copy is one
# `git add -A` away from being committed. knip also walks them and reports
# every file in them as unused.
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# Remember plugin local session history
.remember/
.env*

# Agent scratch, never source
.claude/settings.local.json
.superpowers/

# Higgsfield CLI companion skills, installed into the project by
# `npx skills add higgsfield-ai/skills`. Local tooling, not source: ~1.2MB of
# third-party instruction files that the CLI reinstalls on demand.
.agents/
.claude/skills/
skills-lock.json

# Impeccable local session state. DESIGN.md and .impeccable/design.json are
# tracked (they are the design record); the live-mode server state, the
# detector cache and machine-local config are not.
.impeccable/live/
.impeccable/hook.cache.json
.impeccable/*.local.json
