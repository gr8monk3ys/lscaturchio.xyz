/node_modules
/.pnp
.pnp.js

# bun.lock is the canonical lockfile; don't let a stray npm install re-add this
package-lock.json

# testing
/coverage
/playwright-report
/test-results
.playwright-mcp/
.playwright-cli/
.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# local voice cloning
/voice/
scripts/.tts-venv/
__pycache__/
public/audio/.tmp/
/tmp/

# Blog audio.
#
# WARNING: this rule is currently inert and misleading. All 83 existing MP3s
# are already tracked (they were force-added), so .gitignore does not exclude
# them — `git ls-files public/audio/*.mp3` lists all of them, and they are
# ~459MB of git history. Production serves them straight from the repo; no CDN
# is configured.
#
# The rule does still apply to *new* files, which is the trap: audio generated
# for the next post would be silently ignored, never deploy, and 404 while
# every older post works. Until the CDN migration lands, `git add -f` any new
# MP3 so it matches the others.
#
# Migration path: docs/operations.md "Serving audio from a CDN".
public/audio/*.mp3

# typescript
*.tsbuildinfo
next-env.d.ts
