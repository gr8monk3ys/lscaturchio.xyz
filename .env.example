# ============================================
# REQUIRED - Core Services
# ============================================

# AI Provider - Choose ONE of the following:

# Option 1: Ollama (FREE, LOCAL - Recommended)
# Install: https://ollama.ai/download
# Then run: ollama pull nomic-embed-text && ollama pull llama3.2
# No API key needed - just start Ollama and the app will use it automatically
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Option 2: OpenAI (PAID - Optional)
# Get from: https://platform.openai.com/api-keys
# If set, OpenAI will be used instead of Ollama
# OPENAI_API_KEY=sk-your-key-here
# Optional: primary and fallback chat models (fallback is used only if primary fails)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_CHAT_MODEL=gpt-4.1-nano

# Option 3: OpenRouter (PAID - Optional fallback/multi-provider routing)
# Get from: https://openrouter.ai/keys
# Used after OpenAI fails (if configured), before Ollama fallback.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=openai/gpt-4.1-nano
# OPENROUTER_FALLBACK_CHAT_MODEL=
# Optional attribution headers recommended by OpenRouter
# OPENROUTER_SITE_URL=https://lscaturchio.xyz
# OPENROUTER_APP_NAME=lscaturchio.xyz

# Neon PostgreSQL Database URL (REQUIRED)
# Get from: Neon Console > Connection Details > Connection String
# Used by: All database operations (views, newsletter, embeddings)
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require

# ============================================
# OPTIONAL - Enhanced Features
# ============================================

# GitHub Personal Access Token (OPTIONAL - for live contribution graph)
# Get from: https://github.com/settings/tokens (needs 'read:user' scope)
# Used by: /api/github/contributions
# If not set: Falls back to mock data
GITHUB_TOKEN=your_github_personal_access_token

# Custom Site URL (OPTIONAL - defaults to localhost in dev)
# Used for: Canonical URLs, Open Graph, sitemap generation
# Production example: https://lscaturchio.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API Key (OPTIONAL - for contact form email sending)
# Get from: https://resend.com/api-keys
# Used by: /api/contact
# If not set: Contact form logs to console instead of sending email
# NOTE: You must verify your domain in Resend dashboard to send emails
RESEND_API_KEY=your_resend_api_key_here

# Contact Form Email Recipients (OPTIONAL - defaults shown)
# Used by: /api/contact
CONTACT_EMAIL=lorenzosca7@protonmail.ch
CONTACT_FROM_EMAIL=contact@lscaturchio.xyz

# Newsletter From Email (OPTIONAL - for welcome emails)
# Used by: Newsletter welcome email
NEWSLETTER_FROM_EMAIL=newsletter@lscaturchio.xyz

# Newsletter Drip Admin Key (REQUIRED to run the onboarding drip in production)
# Gates POST /api/newsletter/drip, which sends the onboarding email sequence.
# validateApiKey fails CLOSED in production: if this is unset, every call gets a
# 401 and the drip silently never sends. Send it as the `x-api-key` header.
# Generate with: openssl rand -hex 32
NEWSLETTER_ADMIN_API_KEY=

# Retrieval Candidate Threshold (OPTIONAL - default: 0.25)
# Lower bound for the candidate pool in hybrid search, before the stricter
# EMBEDDING_MATCH_THRESHOLD is applied to the final results.
# Used by: src/lib/embeddings.ts
RETRIEVAL_CANDIDATE_THRESHOLD=0.25

# Audio CDN Base URL (OPTIONAL - default: serve from public/audio)
# When set, blog audio is served from this origin instead of the repo, e.g.
# https://cdn.example.com/audio  (no trailing slash required, it is normalized).
# Used by: src/lib/audio-url.ts
# See docs/operations.md "Serving audio from a CDN" before enabling.
NEXT_PUBLIC_AUDIO_CDN_URL=

# Resume fallback URL (OPTIONAL)
# If /public resume file is missing, /api/resume redirects here.
# Example: https://drive.google.com/your-resume-link
RESUME_URL=

# Embedding Search Threshold (OPTIONAL - default: 0.5)
# Range: 0-1, higher = stricter matching (fewer but more relevant results)
# Used by: AI chat and search for finding similar blog content
EMBEDDING_MATCH_THRESHOLD=0.5

# Analytics API Key (OPTIONAL - for protected analytics endpoints)
# Used by: Future analytics endpoints if you want to protect them
# Leave empty if not needed
ANALYTICS_API_KEY=your_analytics_api_key

# ============================================
# EXTERNAL SERVICES - Configure in Platform
# ============================================

# Google Search Console Verification (NOT currently configured)
# To enable: add a `verification: { google: "<code>" }` field to the `metadata`
# export in src/app/layout.tsx. Next.js renders the meta tag from there.
# Get the code from: https://search.google.com/search-console

# Giscus Comments (GitHub Discussions)
# Requires: Enable GitHub Discussions on your repo, then install the Giscus app
# Get the repo/category IDs from: https://giscus.app (paste your repo, copy the
# generated data-repo-id / data-category-id values)
# Used by: src/components/blog/giscus-comments.tsx
# If repo-id/category-id are unset: the comment box renders a setup notice
NEXT_PUBLIC_GISCUS_REPO=gr8monk3ys/lscaturchio.xyz
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Blog Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Node Environment (auto-set by Next.js)
# NODE_ENV=development

# ============================================
# NOTES
# ============================================

# Rate Limiting:
# - All API routes are rate-limited
# - By default uses in-memory storage (resets on server restart)
# - For production: Set Upstash variables below for persistent Redis-based limiting

# Upstash Redis (OPTIONAL - for persistent rate limiting across deploys)
# Get from: https://console.upstash.com > Create Database > REST API
# If not set: Falls back to in-memory rate limiting
# Vercel's Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Newsletter Database:
# - Requires running migration: supabase/migrations/neon_combined_migration.sql
# - Table: newsletter_subscribers
# - Function: count_active_subscribers

# Embeddings:
# - After adding blogs, run: npm run generate-embeddings
# - Stores in Neon PostgreSQL 'embeddings' table with pgvector search
# - Uses OpenAI text-embedding-3-small (768 dims) or Ollama nomic-embed-text model

# PWA Icons:
# - Already generated in /public directory
# - icon-192x192.png, icon-512x512.png, apple-touch-icon.png, favicon.ico

# Sentry Error Tracking (OPTIONAL - for production error monitoring)
# Get DSN from: https://sentry.io > Project Settings > Client Keys (DSN)
# If not set: Error tracking is disabled
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Server-side DSN. src/instrumentation.ts initialises Sentry if EITHER this or
# NEXT_PUBLIC_SENTRY_DSN is set; set this to keep the server DSN out of the
# client bundle.
SENTRY_DSN=
# Optional explicit environment tags for cleaner separation in Sentry
# Production: production | Preview: preview | Development: development
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
# Auth token for source map uploads (optional, from Sentry > Settings > Auth Tokens)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============================================
# SCRIPT-ONLY - not read by the app at runtime
# ============================================

# Text-to-speech generation (npm run generate-tts-openai)
# Used by: scripts/generate-openai-tts.ts. Requires OPENAI_API_KEY.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_MAX_CHARS=3200
# OPENAI_TTS_INSTRUCTIONS=

# Internal link suggestions (npm run suggest-internal-links)
# LINK_SUGGEST_LIMIT=6

# Webmentions (npm run send-webmentions)
# Token from: https://webmention.io settings
# WEBMENTION_IO_TOKEN=

# Chat smoke test (npm run smoke:chat) and uptime probe (npm run uptime:check)
# All optional; each has a sensible default in its script.
# SMOKE_BASE_URL= / SMOKE_CHAT_QUERY= / SMOKE_ATTEMPTS= / SMOKE_INTERVAL_MS= / SMOKE_TIMEOUT_MS=
# UPTIME_BASE_URL= / UPTIME_ATTEMPTS= / UPTIME_INTERVAL_MS= / UPTIME_TIMEOUT_MS=

# Admin portal (/admin) — all five required for the portal to function.
# Publishing commits to main via the GitHub API; see docs/operations.md
# "Publishing Via The Admin Portal" for setup.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# ADMIN_ALLOWED_LOGIN=gr8monk3ys
# ADMIN_SESSION_SECRET=            # openssl rand -hex 32
# GITHUB_CONTENT_TOKEN=            # fine-grained PAT, this repo only, Contents: read/write
# GITHUB_CONTENT_REPO=             # optional, defaults to gr8monk3ys/lscaturchio.xyz

# Security:
# - Never commit .env.local or .env files to git
# - Use different keys for development/production
# - Rotate keys if accidentally exposed
